# ============================================================
#  PRÉ-PRODUCTION — à copier en ".env" dans ~/design-preprod/ sur le VPS.
#  Même fichier docker-compose.yml que la prod : ce sont ces variables
#  qui en font un second site, isolé, sur un autre domaine.
#  Ne JAMAIS committer le .env réel.
# ============================================================

# --- Ce qui distingue la pré-production de la production -----------------
# Nom du projet Docker : il préfixe les volumes, donc la base et les images
# de la pré-production sont TOTALEMENT séparées de celles de la prod.
COMPOSE_PROJECT_NAME=design-preprod

# Noms des conteneurs (uniques sur la machine)
APP_CONTAINER=design-app-preprod
DB_CONTAINER=design-db-preprod

# Domaine servi par Traefik. Il doit exister en DNS (enregistrement A vers
# l'IP du VPS) AVANT le premier démarrage, sinon Let's Encrypt échoue.
APP_HOST=preprod.design.pepinieres-permabondance.fr

# Nom du routeur Traefik (doit différer de celui de la prod, « design »)
ROUTER=design-preprod

# Bandeau « PRÉ-PRODUCTION » + refus d'indexation par les moteurs de recherche
PREPROD=1

# --- Secrets : DIFFÉRENTS de ceux de la production -----------------------
# Ne recopie pas les secrets de prod : ce site est un bac à sable.
#   openssl rand -hex 24
POSTGRES_PASSWORD=change_moi_mot_de_passe_db_preprod

ADMIN_USER=nina

# Hash bcrypt (PAS le mot de passe en clair), ENTRE GUILLEMETS SIMPLES :
#   docker compose run --rm --no-deps design-app node scripts/hash-password.js 'TonMotDePasse'
ADMIN_PASSWORD_HASH='$2a$12$REMPLACE_MOI_PAR_LE_HASH_BCRYPT'

#   openssl rand -hex 32
SESSION_SECRET=change_moi_secret_session_preprod
